<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="30.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controller.UserTabController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <VBox spacing="15.0" prefWidth="220.0" minWidth="220.0" style="-fx-border-color: #333333; -fx-border-width: 0 1 0 0; -fx-padding: 0 20 0 0;">
        <Label text="Usuário" textFill="#ffffff">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        
        <Label fx:id="userNameLabel" text="[Nome]" textFill="#90CAF9">
            <font>
                <Font name="System Italic" size="18.0" />
            </font>
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </Label>

        <Hyperlink text="alterar usuario" onAction="#handleAlterarUsuario" textFill="#cccccc" />
        <Hyperlink text="+ usuario (Adicionar)" onAction="#handleAdicionarUsuario" textFill="#cccccc" />
        <Hyperlink text="- usuario (Excluir)" onAction="#handleExcluirUsuario" textFill="#ffffff" />
        <Hyperlink text="Calculo m3" onAction="#handleCalculoM3" textFill="#cccccc" />
    </VBox>

    <VBox spacing="20.0" HBox.hgrow="ALWAYS">
        
        <VBox alignment="CENTER" styleClass="caixa-destaque">
            <Label fx:id="statusLabel" text="Status: Calculando média dos últimos 12 meses..." textFill="#ffffff" wrapText="true" textAlignment="CENTER">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
        </VBox>

        <Label text="Consumo 12 meses" textFill="#ffffff">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_RIGHT">
            <Button text="adicionar consumo" onAction="#handleAdicionarConsumo" style="-fx-border-color: #ffffff; -fx-border-width: 1px; -fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-cursor: hand;" />
        </HBox>

        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="tabela-destaque">
            <columns>
                <TableColumn fx:id="volumeColumn" prefWidth="150.0" text="m3_gastos" />
                <TableColumn fx:id="dateColumn" prefWidth="200.0" text="data de leitura" />
                <TableColumn fx:id="actionsColumn" prefWidth="100.0" text="Editar | Deletar" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </VBox>
</HBox>