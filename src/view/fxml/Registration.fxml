<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controller.RegistrationController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label styleClass="title-label" text="Configuração Inicial de Perfil">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    
    <Label text="Para calcularmos sua meta ideal de consumo hídrico, precisamos de alguns dados:" wrapText="true" />

    <VBox spacing="5.0" maxWidth="300.0">
        <Label text="Nome Completo:" />
        <TextField fx:id="nameField" promptText="Ex: João Silva" />
    </VBox>

    <VBox spacing="5.0" maxWidth="300.0">
        <Label text="Estado (UF):" />
        <ComboBox fx:id="stateComboBox" promptText="Selecione o Estado" prefWidth="300.0" />
    </VBox>

    <VBox spacing="5.0" maxWidth="300.0">
        <Label text="Número de Residentes na Casa:" />
        <TextField fx:id="residentsField" promptText="Ex: 3" />
    </VBox>

    <Button fx:id="confirmButton" onAction= "#handleConfirmAction" text="Confirmar e Iniciar" prefWidth="300.0">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Button>
    
    <Label fx:id="feedbackLabel" textFill="#e53935" />

</VBox>